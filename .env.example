# ─────────────────────────────────────────────────────────────
# Trade Compliance Copilot — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── LLM inference (Groq) ──
GROQ_API_KEY=
# Model used for agent inference. Pick based on classification-accuracy testing.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase (Postgres + pgvector + Auth) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Public URL exposed to the browser (same value as SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Upstash Redis (job state) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash QStash (agent-step chaining across serverless invocations) ──
QSTASH_TOKEN=
# Regional QStash endpoint (from the Upstash QStash console). Optional; the SDK
# defaults to the global endpoint if unset.
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── App config ──
# Public base URL of the deployment, used to build QStash callback targets.
# Locally with `qstash dev` you can point this at a tunnel; on Vercel set it to the deployment URL.
APP_BASE_URL=http://localhost:3000

# Confidence threshold below which a classification is routed to human review.
# Spec starts at 0.85; tune later.
CONFIDENCE_THRESHOLD=0.85

# Embedding model for RAG (Groq does not serve embeddings; see lib/rag.ts).
# Options documented in README. Leave blank to use the built-in deterministic fallback embedder (dev only).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
